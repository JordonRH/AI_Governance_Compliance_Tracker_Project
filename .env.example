# AITrace reads configuration from the process environment.
# Copy values into your terminal session or explicitly load an ignored .env file.
# Dev: node --env-file=.env --watch-path=./server server/index.js
# Built (after npm run build): node --env-file=.env server/index.js --production
# Full setup/bootstrap and supported ranges: docs/project/development.md
PORT=5173
# Set DATABASE_URL for Supabase/PostgreSQL. If unset, local development uses SQLite.
# DATABASE_URL=postgresql://...
AITRACE_BIND_HOST=127.0.0.1
AITRACE_REQUEST_BODY_LIMIT_BYTES=32768
# Create accounts with npm run account:create. Never save AITRACE_ACCOUNT_PASSWORD here.

AITRACE_REMINDER_INTERVAL_MS=60000
# Optional HTTPS: configure both PEM files. Keep private keys outside version control.
# AITRACE_TLS_CERT_PATH=C:/secure/aitrace-cert.pem
# AITRACE_TLS_KEY_PATH=C:/secure/aitrace-key.pem
AITRACE_LOGIN_MAX_ATTEMPTS=10
AITRACE_LOGIN_WINDOW_MS=900000

# Optional administrator-managed staging directory (default below; keep outside Git).
# AITRACE_CERTIFICATES_DIR=data/certificates
# Activate a staged pair after copying its path from Administrator > Certificates.
# Use this OR the separate PEM settings above, then restart the server.
# AITRACE_TLS_BUNDLE_PATH=C:/secure/aitrace/organisation-bundle.json
